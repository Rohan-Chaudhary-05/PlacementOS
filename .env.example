# PlacementOS environment variables.
# Copy this file to `.env.local` and fill in the values. See SUPABASE_SETUP.md.

# --- Supabase (Project Settings → API) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# service_role secret — SERVER ONLY. Never prefix with NEXT_PUBLIC, never import in client code.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# --- Site URL (auth email redirect base) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Resend (transactional email for new-opportunity notifications) ---
# https://resend.com → API Keys. Sign up with the same inbox you set as
# NOTIFY_EMAIL so Resend's testing sender (onboarding@resend.dev) can deliver
# to it without verifying a domain. All three values are required for email to
# send; if any is missing, notifications are skipped (submissions still save).
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=you@example.com
RESEND_FROM=PlacementOS <onboarding@resend.dev>

# --- Staff seed account (used by `npm run db:seed`) ---
STAFF_EMAIL=staff@example.com
STAFF_PASSWORD=choose-a-strong-password
